{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile for merchants and carriers",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "nombre": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "tipoCuenta": { "type": "string", "enum": ["natural", "ruc10", "ruc20"] },
        "telefono": { "type": "string" },
        "documento": { "type": "string" },
        "tipoUsuario": { "type": "string", "enum": ["comerciante", "transportista", "admin"] },
        "verificado": { "type": "string", "enum": ["pendiente", "verificado", "rechazado"] },
        "rating": { "type": "number" },
        "totalRatings": { "type": "number" },
        "sumRatings": { "type": "number" },
        "completedTrips": { "type": "number" },
        "indiceConfiabilidad": { "type": "number" },
        "metodoPago": { "type": "string", "enum": ["bank", "yape", "plin"] },
        "datosPago": {
          "type": "object",
          "properties": {
            "banco": { "type": "string" },
            "numeroCuenta": { "type": "string" },
            "cci": { "type": "string" },
            "titular": { "type": "string" },
            "celular": { "type": "string" },
            "fotoUrl": { "type": "string" }
          }
        },
        "ruc": { "type": "string" },
        "razonSocial": { "type": "string" },
        "sector": { "type": "string", "enum": ["alimentos_procesados", "agroindustrial", "metalmecanica", "confecciones", "otro"] },
        "puertoPrincipal": { "type": "string", "enum": ["callao", "paita", "matarani", "ilo", "otro"] },
        "agenteAduana": { "type": "string" },
        "documentosUrls": {
          "type": "object",
          "properties": {
            "dni": { "type": "string" },
            "licencia": { "type": "string" },
            "tarjetaPropiedad": { "type": "string" },
            "soat": { "type": "string" }
          }
        },
        "vehiculo": {
          "type": "object",
          "properties": {
            "tipo": { "type": "string" },
            "placa": { "type": "string" },
            "capacidad": { "type": "string" }
          }
        },
        "zonasOperacion": {
          "type": "array",
          "items": { "type": "string" }
        },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "nombre", "email", "tipoUsuario", "verificado", "createdAt"]
    },
    "Cargo": {
      "title": "Cargo",
      "description": "Cargo shipment request",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "comercianteId": { "type": "string" },
        "comercianteNombre": { "type": "string" },
        "origen": { "type": "string" },
        "destino": { "type": "string" },
        "origenCoords": { "type": "object" },
        "destinoCoords": { "type": "object" },
        "tipoDeCarga": { "type": "string" },
        "vehiculo": {
          "type": "object",
          "properties": {
            "tipo": { "type": "string" },
            "otroTipo": { "type": "string" },
            "caracteristicas": { "type": "array", "items": { "type": "string" } },
            "capacidad": {
              "type": "object",
              "properties": {
                "peso": { "type": "string" },
                "volumen": { "type": "string" },
                "pallets": { "type": "string" },
                "dimensiones": { "type": "string" }
              }
            }
          }
        },
        "nombreProducto": { "type": "string" },
        "horario": { "type": "string" },
        "descripcion": { "type": "string" },
        "precioPropuesto": { "type": "number" },
        "estado": { "type": "string", "enum": ["disponible", "en_negociacion", "asignado", "completado"] },
        "createdAt": { "type": "number" },
        "lote": { "type": "string" },
        "partidaArancelaria": { "type": "string" },
        "puertoDestino": { "type": "string" },
        "numeroContenedor": { "type": "string" },
        "temperaturaRequerida": { "type": "string" },
        "certificacion": { "type": "string" },
        "eudr": { "type": "string" },
        "guiaRemision": { "type": "string" },
        "fechaHoraLimitePuerto": { "type": "number" }
      },
      "required": ["comercianteId", "tipoDeCarga", "origen", "destino", "nombreProducto", "descripcion", "precioPropuesto", "estado", "createdAt"]
    },
    "Offer": {
      "title": "Offer",
      "description": "Carrier offer for a cargo",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cargoId": { "type": "string" },
        "transportistaId": { "type": "string" },
        "precioOfertado": { "type": "number" },
        "estado": { "type": "string", "enum": ["pendiente", "aceptada", "rechazada"] },
        "createdAt": { "type": "number" }
      },
      "required": ["cargoId", "transportistaId", "precioOfertado", "estado", "createdAt"]
    },
    "Trip": {
      "title": "Trip",
      "description": "Active or completed trip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "cargoId": { "type": "string" },
        "comercianteId": { "type": "string" },
        "transportistaId": { "type": "string" },
        "transportistaNombre": { "type": "string" },
        "vehiculo": {
          "type": "object",
          "properties": {
            "tipo": { "type": "string" },
            "placa": { "type": "string" }
          }
        },
        "origen": { "type": "string" },
        "destino": { "type": "string" },
        "fechaHoraLimitePuerto": { "type": "number" },
        "nombreProducto": { "type": "string" },
        "lote": { "type": "string" },
        "guiaRemision": { "type": "string" },
        "temperaturaRequerida": { "type": "string" },
        "lastTempUpdateAt": { "type": "number" },
        "temperaturaActual": { "type": "string" },
        "recojoEstado": { "type": "string" },
        "recojoTemp": { "type": "string" },
        "entregaEstado": { "type": "string" },
        "entregaTemp": { "type": "string" },
        "precioFinal": { "type": "number" },
        "comision": { "type": "number" },
        "estado": { "type": "string", "enum": ["pendiente_pago", "pago_en_revision", "en_camino_a_recojo", "recojo_completado", "en_camino_a_destino", "entregado_pendiente_confirmacion", "completado", "cancelado"] },
        "pagoInfo": {
          "type": "object",
          "properties": {
            "referencia": { "type": "string" },
            "comprobanteUrl": { "type": "string" },
            "informadoAt": { "type": "number" },
            "fechaPago": { "type": "number" },
            "verificadoPor": { "type": "string" },
            "verificadoAt": { "type": "number" }
          }
        },
        "payoutInfo": {
          "type": "object",
          "properties": {
            "estado": { "type": "string", "enum": ["pendiente", "pagado"] },
            "referencia": { "type": "string" },
            "comprobanteUrl": { "type": "string" },
            "pagadoAt": { "type": "number" },
            "montoPagado": { "type": "number" }
          }
        },
        "seguimiento": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "updatedAt": { "type": "number" }
          }
        },
        "alertas": {
          "type": "object",
          "properties": {
            "desvioRuta": { "type": "boolean" },
            "retrasoCritico": { "type": "boolean" },
            "paradaNoAutorizada": { "type": "boolean" },
            "perdidaSignal": { "type": "boolean" },
            "riesgoLlegadaTardia": { "type": "boolean" }
          }
        },
        "evidencia": {
          "type": "object",
          "properties": {
            "recojoUrl": { "type": "string" },
            "recojoTimestamp": { "type": "number" },
            "recojoEstado": { "type": "string" },
            "recojoTemperatura": { "type": "number" },
            "entregaUrl": { "type": "string" },
            "entregaTimestamp": { "type": "number" },
            "entregaEstado": { "type": "string" },
            "entregaTemperatura": { "type": "number" }
          }
        },
        "tiempoEstimado": { "type": "string" },
        "fechaRecojo": { "type": "string" },
        "horaRecojo": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["cargoId", "comercianteId", "transportistaId", "origen", "destino", "precioFinal", "estado", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "User review for a trip",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tripId": { "type": "string" },
        "reviewerId": { "type": "string" },
        "revieweeId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["tripId", "reviewerId", "revieweeId", "rating", "createdAt"]
    },
    "SupportTicket": {
      "title": "SupportTicket",
      "description": "Support case for users",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "topic": { "type": "string", "enum": ["consulta", "fallo", "queja"] },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "topic", "status", "createdAt"]
    },
    "SupportChat": {
      "title": "SupportChat",
      "description": "Real-time support messages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "isAdmin": { "type": "boolean" },
        "createdAt": { "type": "number" }
      },
      "required": ["userId", "text", "senderId", "createdAt"]
    },
    "EnterpriseAuditLog": {
      "title": "EnterpriseAuditLog",
      "description": "Immutable real-time logistics compliance transaction log document",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "user": { "type": "string" },
        "action": { "type": "string" },
        "affectedEntity": { "type": "string" },
        "before": { "type": "object" },
        "after": { "type": "object" },
        "organizationId": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["user", "action", "affectedEntity", "organizationId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/cargas/{cargoId}": {
      "schema": "Cargo",
      "description": "Cargo requests"
    },
    "/cargas/{cargoId}/offers/{offerId}": {
      "schema": "Offer",
      "description": "Carrier offers for cargo"
    },
    "/trips/{tripId}": {
      "schema": "Trip",
      "description": "Active and past trips"
    },
    "/reviews/{reviewId}": {
      "schema": "Review",
      "description": "User reviews"
    },
    "/support_tickets/{ticketId}": {
      "schema": "SupportTicket",
      "description": "User support tickets"
    },
    "/support_chats/{chatId}": {
      "schema": "SupportChat",
      "description": "Support chat messages"
    },
    "/organizations/{orgId}": {
      "schema": "object",
      "description": "Enterprise organizations"
    },
    "/sedes/{sedeId}": {
      "schema": "object",
      "description": "Multi-sede branches mapping"
    },
    "/vehicles/{vehicleId}": {
      "schema": "object",
      "description": "Fleet telematic vehicles"
    },
    "/drivers/{driverId}": {
      "schema": "object",
      "description": "Fleet registered drivers with credentials"
    },
    "/enterpriseCargos/{cargoId}": {
      "schema": "object",
      "description": "Enterprise transport cargoes"
    },
    "/enterpriseTrips/{tripId}": {
      "schema": "object",
      "description": "Real-time enterprise telematic trips"
    },
    "/enterpriseChats/{chatId}": {
      "schema": "object",
      "description": "Intra-enterprise chat messages and logs"
    },
    "/enterpriseCarriers/{carrierId}": {
      "schema": "object",
      "description": "Associated and certified enterprise carrier partners"
    },
    "/enterpriseIncidents/{incidentId}": {
      "schema": "object",
      "description": "Registered and tracked telematic road incidents"
    },
    "/audit_logs/{logId}": {
      "schema": "EnterpriseAuditLog",
      "description": "Logs tracking security, modifications, status transitions and telematic exceptions in real-time"
    },
    "/config/{configId}": {
      "schema": "object",
      "description": "System configuration"
    }
  }
}
